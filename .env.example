# Triple Stack LLM configuration — copy to .env and fill in. NEVER commit your real .env.

# ---- Tier 2: DeepSeek (cheap cloud) ----
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Tier 3: Claude (premium / fallback) ----
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ---- Tier 1: local on-device SLM (Apple Silicon / MLX) ----
# TRIPLESTACK_LOCAL=1
# TRIPLESTACK_LOCAL_MODEL=mlx-community/Qwen3.5-2B-4bit

# ---- behaviour (optional) ----
# TRIPLESTACK_LOCAL_RETRIES=1
# TRIPLESTACK_CLOUD_RETRIES=3
# TRIPLESTACK_TIMEOUT=60
